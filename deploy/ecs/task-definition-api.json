{
  "family": "ticketstream-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "ticketstream/api:latest",
      "essential": true,
      "command": ["api"],
      "portMappings": [
        { "containerPort": 8080, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "APP_ENV", "value": "production" },
        { "name": "APP_PORT", "value": "8080" },
        { "name": "EXPIRED_SWEEP_SECONDS", "value": "5" },
        { "name": "RATE_LIMIT_RESERVE", "value": "8" },
        { "name": "RATE_LIMIT_AUTH", "value": "40" },
        { "name": "RATE_LIMIT_WINDOW_SECONDS", "value": "10" }
      ],
      "secrets": [
        { "name": "POSTGRES_URL", "valueFrom": "arn:aws:secretsmanager:region:account:secret:ticketstream/postgres" },
        { "name": "REDIS_URL", "valueFrom": "arn:aws:secretsmanager:region:account:secret:ticketstream/redis" },
        { "name": "RABBITMQ_URL", "valueFrom": "arn:aws:secretsmanager:region:account:secret:ticketstream/rabbitmq" },
        { "name": "KEYCLOAK_ISSUER_URL", "valueFrom": "arn:aws:secretsmanager:region:account:secret:ticketstream/keycloak/issuer" },
        { "name": "KEYCLOAK_AUDIENCE", "valueFrom": "arn:aws:secretsmanager:region:account:secret:ticketstream/keycloak/audience" },
        { "name": "KEYCLOAK_JWKS_URL", "valueFrom": "arn:aws:secretsmanager:region:account:secret:ticketstream/keycloak/jwks" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ticketstream-api",
          "awslogs-region": "eu-central-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
