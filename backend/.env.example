APP_PORT=8080
APP_ENV=dev
MIGRATIONS_DIR=/app/migrations
POSTGRES_URL=postgres://ticketstream:ticketstream@db:5432/ticketstream?sslmode=disable
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
KEYCLOAK_ISSUER_URL=http://localhost:18081/realms/ticketstream
KEYCLOAK_AUDIENCE=ticketstream-frontend
KEYCLOAK_JWKS_URL=http://host.docker.internal:18081/realms/ticketstream/protocol/openid-connect/certs
SEAT_LOCK_TTL_SECONDS=600
RATE_LIMIT_RESERVE=5
RATE_LIMIT_WINDOW_SECONDS=10
